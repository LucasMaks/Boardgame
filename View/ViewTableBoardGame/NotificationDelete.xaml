<Window x:Class="Boardgame.View.NotificationDelete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boardgame.View"
        mc:Ignorable="d"
        d:Width="350" d:Height="110"
        Title="NotificationDelete"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        Width="360" Height="110">
    <Grid Height="110" VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                    <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        </Border>

        <!-- Message Content -->
        <TextBlock x:Name="MessageTextBlock"
                   Foreground="{StaticResource color12}"
                   Text="Do you want to remove the board game?"
                   TextWrapping="Wrap"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   FontSize="16" />

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Margin="80,60,80,20">
            <RadioButton x:Name="YesButton" Content="Yes"  Style="{StaticResource menuButtonNotificatioYes}" Click="YesButton_Click"  />
            <RadioButton x:Name="NoButton" Content="No" Style="{StaticResource menuButtonNotificationNo}" Click="NoButton_Click"  />
        </StackPanel>
    </Grid>
</Window>
