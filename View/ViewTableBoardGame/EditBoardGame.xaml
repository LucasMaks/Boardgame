<Window x:Class="Boardgame.View.EditBoardGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:Boardgame.View"
        xmlns:vm="clr-namespace:Boardgame.ViewModel"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="410"
        Title="EditBoardGame"  
        Width="410"
        WindowStyle="None"
Background="Transparent"
        Loaded="Window_Loaded">
    
    <Window.DataContext>
        <vm:EditBoardGameVM/>
    </Window.DataContext>

    <Grid>
        <!--// Base Grid //-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                    <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Control bar-->
            <StackPanel x:Name="pnlControlBar"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    FlowDirection="RightToLeft"
                    Background="Transparent"
                    Margin="0,0,10,0"
                    MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                    MouseEnter="pnlControlBar_MouseEnter">

                <Button x:Name="btnClose"
    Style="{StaticResource ControlButton}"
    Tag="{StaticResource color4}"
    Click="btnClose_Click">
                    <fa:IconImage Icon="WindowClose" Width="12" Style="{StaticResource ControlButtonIcon}"/>

                </Button>

                <Button x:Name="btnMaximize"
        Style="{StaticResource ControlButton}"
        Tag="{StaticResource color6}"
        Click="btnMaximize_Click">
                    <fa:IconImage Icon="WindowMaximize" Width="12" Style="{StaticResource ControlButtonIcon}"/>

                </Button>

                <Button x:Name="btnMinimize"
        Style="{StaticResource ControlButton}"
        Tag="{StaticResource color8}"
        Click="btnMinimize_Click">
                    <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource ControlButtonIcon}"/>

                </Button>
            </StackPanel>
            <!--Header / Caption-->
            <Grid Grid.Row="1" HorizontalAlignment="Center" MaxWidth="410" Height="425" VerticalAlignment="Center" Width="410">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!--Title Edit Board Game-->
                <TextBlock Text="Edit board game"
                       Foreground="{StaticResource titleColor3}"
                       FontSize="19"
                       FontFamily="Montserrat"
                       FontWeight="Normal"
                       TextAlignment="Center"
                       Margin="130,20,130,0" 
                       Height="21" 
                       MaxWidth="160"
                       VerticalAlignment="Top"/>

                <!--Title Board Game-->
                <TextBlock Text="Title board game"
                       Foreground="{StaticResource titleColor3}"
                       FontSize="14"
                       FontFamily="Montserrat"
                       FontWeight="Normal"
                       VerticalAlignment="Top"
                       Margin="40,65,0,0" 
                       HorizontalAlignment="Left" 
                       Height="17"
                       Width="330"/>

                <TextBox x:Name="Title"
                     Style="{StaticResource TextBoxNames}" 
                     Width="330" 
                     SelectionOpacity="1" 
                     Margin="40,85,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left" 
                      TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Height="Auto"
                         MaxHeight="40" >
                </TextBox>
                <!--Description-->

                <TextBlock Text="Description board game"
                       Foreground="{StaticResource titleColor3}"
                       FontSize="14"
                       FontFamily="Montserrat"
                       FontWeight="Normal"
                       Margin="40,125,0,0"
                       HorizontalAlignment="Left"
                       Width="330" 
                           Height="17" 
VerticalAlignment="Top"/>

                <TextBox x:Name="Description"
                     Style="{StaticResource TextBoxNames}"
                     TextWrapping="Wrap"
   AcceptsReturn="True"
   VerticalScrollBarVisibility="Auto"
   Height="Auto"
   MaxHeight="40"
                     Width="330" 
                     SelectionOpacity="1"
                     Margin="40,145,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"/>
                <!--People-->
                <TextBlock Text="Number of players"
                       Foreground="{StaticResource titleColor3}"
                       FontSize="14"
                       FontFamily="Montserrat"
                       FontWeight="Normal"
                       VerticalAlignment="Top"
                       Margin="40,185,0,0"
                       HorizontalAlignment="Left"
                       Height="18"
                       Width="330"/>

                <TextBox x:Name="People"
                Style="{StaticResource TextBoxNames}"
                Width="330" 
                SelectionOpacity="1" 
                Margin="40,205,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Height="30"/>

                <!--Hourse-->
                <TextBlock Text="Estimated playing time"
                       Foreground="{StaticResource titleColor3}"
                       FontSize="14"
                       FontFamily="Montserrat"
                       FontWeight="Normal"
                       VerticalAlignment="Top"
                       Margin="40,245,0,0"
                       HorizontalAlignment="Left"
                       Height="18"
                       Width="330"/>

                <TextBox x:Name="Hours"
                Style="{StaticResource TextBoxNames}"
                Width="330" 
                SelectionOpacity="1" 
                Margin="40,265,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Height="30"/>
                <RadioButton x:Name="SaveBoardGame"
     Style="{StaticResource SeaveButton}"
     Tag="{StaticResource color4}"
     Margin="5,0,0,50" 
     VerticalAlignment="Bottom" 
     Click="SaveBoardGame_Click" Checked="SaveBoardGame_Checked">

                    <StackPanel Orientation="Horizontal" 
             VerticalAlignment="Center" 
             HorizontalAlignment="Center" Width="120">

                        <fa:IconImage Icon="PlusCircle" 
                   Style="{StaticResource menuButtonIconSave}" 
                   RenderTransformOrigin="-0.123,0.42"/>

                        <TextBlock Style="{StaticResource menuButtonText}" 
                               Foreground="{StaticResource color4}" 
                               Width="42"><Run Language="pl-PL" Text=""/><Run Text=" "/><Run Language="en-EN"  Text="Save"/></TextBlock>

                    </StackPanel>
                </RadioButton>
            </Grid>
        </Grid>

    </Grid>
</Window>
