<Window x:Class="Boardgame.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:vm="clr-namespace:Boardgame.ViewModel"
        xmlns:Menu="clr-namespace:Boardgame.Utilities"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.DataContext>
        <vm:NavigationVm/>
    </Window.DataContext>

    <!--// WindowBorder //-->
    <Border CornerRadius="10" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border CornerRadius="10" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== NAV MENU (authenticated only) ===== -->
                <Border Grid.Column="0"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- App title -->
                            <StackPanel Orientation="Horizontal" Height="35" Margin="15,25,0,20">
                                <fa:IconImage Icon="Dice" Width="20" Height="20"
                                              Foreground="{StaticResource color2}" Margin="10,0,10,0"/>
                                <TextBlock Text="Board games"
                                           Foreground="{StaticResource titleColor2}"
                                           FontSize="18" FontFamily="Montserrat"
                                           FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Home -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color1}"
                                             Command="{Binding StarPageCommand}"
                                             Click="BtnControl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Home" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>

                            <!-- Drawing -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color2}"
                                             Command="{Binding DrawingsComannd}"
                                             Click="RadioButton_Click_Draw" Width="259"
                                             Checked="BtnControl_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Dice" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Losowanie" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>

                            <!-- Table of board games -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color3}"
                                             Command="{Binding TableBoardGamesCommand}"
                                             Click="RadioButton_Click_BoardGame"
                                             Checked="RadioButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="TableList" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Katalog gier" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>

                            <!-- Tournaments -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color6}"
                                             Command="{Binding TournamentsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Trophy" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Turnieje" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>

                            <!-- Events -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color8}"
                                             Command="{Binding EventsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="CalendarDays" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Wydarzenia" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>

                            <!-- Community -->
                            <Menu:BtnControl Style="{StaticResource menuButton}"
                                             Tag="{StaticResource color5}"
                                             Command="{Binding CommunityCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="UserGroup" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Społeczność" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </Menu:BtnControl>
                        </StackPanel>

                        <!-- Bottom: Notifications + User info + Logout -->
                        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#C8C0F0" Margin="8,0,8,8">
                            <StackPanel>

                                <!-- Notification bell row -->
                                <Grid Margin="4,10,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Powiadomienia"
                                               Foreground="{StaticResource plainTextColor3}"
                                               FontSize="12" FontFamily="Montserrat"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <!-- Bell button + badge -->
                                    <Button Grid.Column="1" Command="{Binding ToggleNotifPanelCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Width="36" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BellBg" Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                    <Grid Width="24" Height="24">
                                                        <fa:IconImage Icon="Bell" Width="18" Height="18"
                                                                      Foreground="#6B68A8"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                        <!-- Unread badge -->
                                                        <Border Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"
                                                                Background="#FB539B" CornerRadius="7"
                                                                MinWidth="14" Height="14" Padding="2,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding UnreadCount}"
                                                                       Foreground="White" FontSize="9"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BellBg" Property="Background" Value="#D4CCFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Notification drop-down panel -->
                                <Border Visibility="{Binding IsNotifPanelOpen, Converter={StaticResource BoolToVis}}"
                                        Background="#F0ECFF" CornerRadius="10" Margin="4,0,4,6"
                                        MaxHeight="260">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Panel header -->
                                        <Grid Grid.Row="0" Margin="10,8,10,4">
                                            <TextBlock Text="Powiadomienia" Foreground="#1A1240"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"/>
                                            <Button HorizontalAlignment="Right"
                                                    Command="{Binding MarkAllReadCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" FontSize="10"
                                                    Foreground="#6D2FFF" FontFamily="Segoe UI">
                                                Oznacz jako przeczytane
                                            </Button>
                                        </Grid>

                                        <!-- List -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Notifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="6,2" Padding="8,6" CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                            <Setter Property="Background" Value="#E0D8FF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="#1A1240" FontSize="11"
                                                                           FontWeight="SemiBold" FontFamily="Segoe UI"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Message}"
                                                                           Foreground="#5A5490" FontSize="10"
                                                                           FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                                           Foreground="#8B87BA" FontSize="9"
                                                                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- User info row -->
                                <Grid Margin="5,4,5,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="#6D2FFF" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding LoggedInUserName, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding LoggedInUserName}"
                                               Foreground="{StaticResource titleColor2}"
                                               FontSize="13" FontFamily="Montserrat" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Logout -->
                                    <Button Grid.Column="2" Command="{Binding LogoutCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Wyloguj">
                                        <fa:IconImage Icon="RightFromBracket" Width="16" Height="16" Foreground="#6B68A8"/>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D4CCFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== CONTENT AREA (authenticated only) ===== -->
                <Border Grid.Column="1" CornerRadius="0,10,10,0"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0.7">
                            <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control bar -->
                        <StackPanel x:Name="pnlControlBar" Grid.Row="0"
                                    Orientation="Horizontal" FlowDirection="RightToLeft"
                                    Background="Transparent" Margin="0,0,10,0"
                                    MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                                    MouseEnter="pnlControlBar_MouseEnter">
                            <Button x:Name="btnClose" Style="{StaticResource ControlButton}"
                                    Tag="{StaticResource color4}" Click="btnClose_Click">
                                <fa:IconImage Icon="WindowClose" Width="12" Style="{StaticResource ControlButtonIcon}"/>
                            </Button>
                            <Button x:Name="btnMaximize" Style="{StaticResource ControlButton}"
                                    Tag="{StaticResource color6}" Click="btnMaximize_Click">
                                <fa:IconImage Icon="WindowMaximize" Width="12" Style="{StaticResource ControlButtonIcon}"/>
                            </Button>
                            <Button x:Name="btnMinimize" Style="{StaticResource ControlButton}"
                                    Tag="{StaticResource color8}" Click="btnMinimize_Click">
                                <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource ControlButtonIcon}"/>
                            </Button>
                        </StackPanel>

                        <!-- Header -->
                        <Grid Grid.Row="1"/>

                        <!-- Content -->
                        <Grid Grid.Row="2">
                            <Border CornerRadius="0,20,20,0">
                                <ContentControl x:Name="panelSelect"
                                                Content="{Binding CurrentView}"
                                                Margin="10,0,10,10"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== LOGIN OVERLAY (not authenticated) — spans both columns ===== -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="10"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource InvBoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#07002A" Offset="0"/>
                            <GradientStop Color="#150B3E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ContentControl Content="{Binding LoginVM}"/>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>

