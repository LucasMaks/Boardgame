<UserControl x:Class="Boardgame.View.Drawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Boardgame.ViewModel"
            xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" d:DesignWidth="800" Height="600">

    <UserControl.DataContext>
        <vm:DrawingsVM/>
    </UserControl.DataContext>

    <Border CornerRadius="10" Grid.Column="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock FontSize="24" FontFamily="Segoe UI">
                    <Run Text="🎲 "/>
                    <Run Text="Losowanie" Foreground="#6D2FFF" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#6D2FFF" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Panel losowania -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Gracze (po przecinku)" Foreground="#5A5490" FontSize="12"
                                   FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBox x:Name="People"
                            Style="{StaticResource TextBoxNames}"
                            Text="Gracze..."
                            GotFocus="People_GotFocus"
                            LostFocus="People_LostFocus"
                            Height="34"/>
                    </StackPanel>

                    <RadioButton Grid.Column="1" x:Name="DrawingButto"
                        Style="{StaticResource menuDrawingButton}"
                        Tag="{StaticResource color6}"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="Drawing_Click" Checked="Drawing_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Width="180" Height="50">
                            <fa:IconImage Icon="DICE"
                                Style="{StaticResource menuDrawingIcon}"
                                RenderTransformOrigin="-0.123,0.42"/>
                            <TextBlock Style="{StaticResource DrawingStyleText}"
                                Foreground="{StaticResource color6}"
                                Width="100"><Run Text="LOSUJ"/></TextBlock>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Wyniki -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Historia sesji -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Historia sesji" Foreground="#1A1240" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                        <DataGrid
                            ItemsSource="{Binding GameSessions}"
                            Style="{DynamicResource DataGridStyle2}"
                            CellStyle="{DynamicResource DataGridCellStyle2}"
                            ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle2}"
                            RowStyle="{DynamicResource DataGridRowStyle2}"
                            x:Name="BoardGameGridView"
                            SelectionChanged="BoardGameGridView_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nr" IsReadOnly="True" Width="Auto" MinWidth="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Number}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Czas" IsReadOnly="True" Width="*" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Duration}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tytuł" IsReadOnly="True" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Wykres -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Czas rozgrywek" Foreground="#1A1240" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                        <Grid>
                            <lvc:PieChart Series="{Binding GameDurations}"
                                          LegendLocation="Bottom"
                                          Height="300"
                                          InnerRadius="70">
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend Foreground="{StaticResource plainTextColor1}"/>
                                </lvc:PieChart.ChartLegend>
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip BulletSize="10"/>
                                </lvc:PieChart.DataTooltip>
                            </lvc:PieChart>
                            <TextBlock Text="{Binding TotalDuration, StringFormat=Łącznie: \{0\} h}"
                                       Width="130" FontSize="14"
                                       Margin="0,120,0,160"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource titleColor1}"
                                       Visibility="{Binding IsTotalVisible}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
