<UserControl x:Class="Boardgame.View.Drawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Boardgame.ViewModel"
            xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" d:DesignWidth="800" Height="600">

    <UserControl.DataContext>
        <vm:DrawingsVM/>
    </UserControl.DataContext>

    <Border CornerRadius="10"
            Grid.Column="1" Margin="0,0,0,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource winBorderColor7}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!--Content section / Child views-->
                    <RowDefinition Height="200*"/>
                    <RowDefinition Height="300*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <!--People-->
                        <TextBlock Text="How many people Play"
                            Foreground="{StaticResource titleColor3}"
                            FontSize="14"
                            FontFamily="Montserrat"
                            FontWeight="Normal"
                            VerticalAlignment="Top"
                            Margin="50,40,0,0"
                            HorizontalAlignment="Left"
                            Height="18"
                            Width="330"/>

                        <TextBox x:Name="People"
                            Style="{StaticResource TextBoxNames}"
                            Width="250" Text="People..."
                            SelectionOpacity="1" 
                            Margin="50,20,0,0"
                            VerticalAlignment="Top"
                            GotFocus="People_GotFocus"
                            LostFocus="People_LostFocus"
                            HorizontalAlignment="Left"
                            Height="30"/>

                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <RadioButton x:Name="DrawingButto"
                            Style="{StaticResource menuDrawingButton}"
                            Tag="{StaticResource color6}"
                            Margin="0,60,60,0" 
                            VerticalAlignment="Bottom" 
                            Click="Drawing_Click" Checked="Drawing_Checked">

                            <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Width="280" Height="80">

                                <fa:IconImage Icon="DICE"
                                Style="{StaticResource menuDrawingIcon}" 
                                RenderTransformOrigin="-0.123,0.42"/>

                                <TextBlock Style="{StaticResource DrawingStyleText}" 
                                Foreground="{StaticResource color6}" 
                                Width="160"><Run Language="pl-PL" Text=""/><Run Text=" "/><Run Text=" "/><Run Language="en-EN"  Text="DRAW"/></TextBlock>


                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <DataGrid
            ItemsSource="{Binding GameSessions}" 
            Style="{DynamicResource DataGridStyle2}"  
            CellStyle="{DynamicResource DataGridCellStyle2}" 
            ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle2}" 
            RowStyle="{DynamicResource DataGridRowStyle2}" Grid.Row="1" 
            x:Name="BoardGameGridView" SelectionChanged="BoardGameGridView_SelectionChanged">

                            <DataGrid.Columns>


                                <DataGridTemplateColumn Header="Number" IsReadOnly="True" Width="*" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate >
                                            <StackPanel Orientation="Horizontal" >

                                                <TextBlock  Text="{Binding Number}" 
                                                            TextWrapping="Wrap" 
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            MaxWidth="80"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Duration" IsReadOnly="True" Width="*" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate >
                                            <StackPanel Orientation="Horizontal" >

                                                <TextBlock  Text="{Binding Duration}" 
                             TextWrapping="Wrap" 
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             MaxWidth="80"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Title" IsReadOnly="True" Width="*" MinWidth="150" >
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate >
                                            <StackPanel Orientation="Horizontal" >

                                                <TextBlock  Text="{Binding Title}" 
                                      TextWrapping="Wrap" 
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      MaxWidth="230"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <lvc:PieChart Grid.Row="1" Margin="0,0,0,0" 
              Series="{Binding GameDurations}" 
              LegendLocation="Bottom" 
              Height="337" 
              InnerRadius="70"
              >
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend  Foreground="White"/>
                                </lvc:PieChart.ChartLegend>
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip BulletSize="10"/>
                                </lvc:PieChart.DataTooltip>

                            </lvc:PieChart>
                            <TextBlock Text="{Binding TotalDuration, StringFormat=Total: \{0\} hours}" Width="110"
FontSize="16"  Margin="0,145,0,170" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="WhiteSmoke"
                                       Visibility="{Binding IsTotalVisible}"/>
                        </Grid>
                        
                        

                        <!-- Suma czasu rozgrywek -->
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>
