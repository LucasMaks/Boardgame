<UserControl x:Class="Boardgame.View.Drawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Boardgame.ViewModel"
             xmlns:local="clr-namespace:Boardgame.View"
             mc:Ignorable="d" d:DesignWidth="800" Height="596">

    <UserControl.DataContext>
        <vm:StarPageVM/>
    </UserControl.DataContext>

    <Border CornerRadius="10"
            Grid.Column="1" Margin="0,0,0,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0.7">
                <GradientStop Color="{StaticResource winBorderColor4}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor5}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!--Content section / Child views-->
                    <RowDefinition Height="76*"/>
                    <RowDefinition Height="555*"/>
                </Grid.RowDefinitions>
            </Grid>
        </Grid>
    </Border>
</UserControl>
