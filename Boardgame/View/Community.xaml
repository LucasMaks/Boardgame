<UserControl x:Class="Boardgame.View.Community"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:vm="clr-namespace:Boardgame.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="1040">

    <UserControl.DataContext>
        <vm:CommunityVM/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E1F1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9497CD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A1B5E"/>
            <Setter Property="Foreground" Value="#E0E1F1"/>
            <Setter Property="BorderBrush" Value="#3A2878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6D2FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7E3AF2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A2878"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A2878"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2A1B5E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A003A" Offset="0"/>
                    <GradientStop Color="#1C0E49" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock FontSize="24" FontFamily="Segoe UI">
                    <Run Text="👥 "/>
                    <Run Text="Społeczność" Foreground="#9B59B6" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4ADAEC" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Add Player + List -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Nowy gracz" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Nick" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewNickname, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Imię i nazwisko" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Posiadane gry (po przecinku)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewOwnedGames, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>

                                <TextBlock Text="Ulubione gry (po przecinku)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewFavoriteGames, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>

                                <Button Content="Dodaj gracza" Command="{Binding AddPlayerCommand}"
                                        Style="{StaticResource ActionButton}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Player list -->
                        <TextBlock Text="Gracze" Style="{StaticResource SectionTitle}"/>
                        <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C0E49" CornerRadius="8" Padding="10" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar circle -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                                    Background="#6D2FFF" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding AvatarInitials}" Foreground="White" 
                                                           FontWeight="Bold" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nickname}" Foreground="#E0E1F1" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding FullName}" Foreground="#9497CD" FontSize="11"/>
                                                <TextBlock Foreground="#7C80C2" FontSize="10">
                                                    <Run Text="Gier: "/>
                                                    <Run Text="{Binding OwnedGames.Count, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Player details -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasSelectedPlayer, Converter={StaticResource BoolToVis}}">

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="🎯 Rekomendacje" Command="{Binding GenerateRecommendationsCommand}"
                                        Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                                <Button Content="🗑 Usuń gracza" Command="{Binding DeletePlayerCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <!-- Stats -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Statystyki" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#1C0E49" CornerRadius="8" Padding="12" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedPlayer.Stats.GamesPlayed}" 
                                                           Foreground="#FFC047" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Rozegranych" Foreground="#9497CD" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#1C0E49" CornerRadius="8" Padding="12" Margin="5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedPlayer.Stats.TournamentsWon}" 
                                                           Foreground="#4ADAEC" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Wygranych" Foreground="#9497CD" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#1C0E49" CornerRadius="8" Padding="12" Margin="5,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedPlayer.Stats.EventsAttended}" 
                                                           Foreground="#FB539B" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Wydarzeń" Foreground="#9497CD" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Games -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,10">
                                    <StackPanel>
                                        <TextBlock Text="Posiadane gry" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedPlayer.OwnedGames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#E0E1F1" FontSize="12" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Ulubione gry" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedPlayer.FavoriteGames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="#FFC047" FontSize="12" Margin="0,2">
                                                        <Run Text="⭐ "/><Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Exchange -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Wymiana gier" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Oferuję" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding ExchangeGameOffered, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0">
                                            <TextBlock Text="Szukam" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding ExchangeGameWanted, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="+ Dodaj" Command="{Binding CreateExchangeCommand}"
                                                Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="Aktywne oferty" Foreground="#9497CD" FontSize="12" Margin="0,10,0,5"/>
                                    <ItemsControl ItemsSource="{Binding AllExchangeOffers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1C0E49" CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                                    <TextBlock Foreground="#E0E1F1" FontSize="12">
                                                        <Run Text="{Binding GameOffered}" Foreground="#FB539B"/>
                                                        <Run Text=" ↔ " Foreground="#7C80C2"/>
                                                        <Run Text="{Binding GameWanted}" Foreground="#4ADAEC"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Recommendations -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Rekomendacje" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Recommendations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1C0E49" CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding}" Foreground="#E0E1F1" FontSize="12" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding HasSelectedPlayer, Converter={StaticResource InvBoolToVis}}">
                            <Border Style="{StaticResource CardBorder}" Padding="40">
                                <StackPanel HorizontalAlignment="Center">
                                    <fa:IconImage Icon="UserGroup" Width="48" Height="48" Foreground="#3A2878"/>
                                    <TextBlock Text="Wybierz gracza z listy" Foreground="#7C80C2" FontSize="16" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                                    <TextBlock Text="lub dodaj nowego, aby zobaczyć profil" Foreground="#9497CD" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
