<UserControl x:Class="Boardgame.View.Tournaments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:vm="clr-namespace:Boardgame.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="1040">

    <UserControl.DataContext>
        <vm:TournamentsVM/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E1F1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9497CD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A1B5E"/>
            <Setter Property="Foreground" Value="#E0E1F1"/>
            <Setter Property="BorderBrush" Value="#3A2878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6D2FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7E3AF2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A2878"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A2878"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2A1B5E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A003A" Offset="0"/>
                    <GradientStop Color="#1C0E49" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock FontSize="24" FontFamily="Segoe UI">
                    <Run Text="🏆 " />
                    <Run Text="Turnieje" Foreground="#FFC047" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4ADAEC" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Create + List -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                    <StackPanel>
                        <!-- Create Tournament -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Nowy turniej" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Nazwa turnieju" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewTournamentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Gra" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewGameTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Typ" Style="{StaticResource FormLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton Content="Puchar" IsChecked="{Binding IsCupSelected}" Foreground="#E0E1F1" Margin="0,0,15,0"/>
                                    <RadioButton Content="Liga" IsChecked="{Binding IsLeagueSelected}" Foreground="#E0E1F1"/>
                                </StackPanel>

                                <TextBlock Text="Gracze (po przecinku)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NewPlayersText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>

                                <Button Content="Utwórz turniej" Command="{Binding CreateTournamentCommand}"
                                        Style="{StaticResource ActionButton}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tournament List -->
                        <TextBlock Text="Lista turniejów" Style="{StaticResource SectionTitle}"/>
                        <ListBox ItemsSource="{Binding Tournaments}" 
                                 SelectedItem="{Binding SelectedTournament}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#E0E1F1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C0E49" CornerRadius="8" Padding="10" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="#FFC047" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Foreground="#9497CD" FontSize="11">
                                                <Run Text="{Binding GameTitle}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding Type}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding Status}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#7C80C2" FontSize="11">
                                                <Run Text="Graczy: "/>
                                                <Run Text="{Binding Players.Count, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Panel: Details -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasSelectedTournament, Converter={StaticResource BoolToVis}}">

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="🎲 Generuj drabinkę" Command="{Binding GenerateBracketCommand}"
                                        Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                                <Button Content="🗑 Usuń turniej" Command="{Binding DeleteTournamentCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <!-- Matches -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Mecze" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding CurrentMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1C0E49" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding MatchNumber, StringFormat=#{0}}" 
                                                                   Foreground="#7C80C2" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Player1}" 
                                                                   Foreground="#E0E1F1" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0" FontSize="13">
                                                            <Run Text="{Binding ScorePlayer1}" Foreground="#FFC047"/>
                                                            <Run Text=" : " Foreground="#7C80C2"/>
                                                            <Run Text="{Binding ScorePlayer2}" Foreground="#FFC047"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding Player2}" 
                                                                   Foreground="#E0E1F1" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#FB539B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="#4ADAEC"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding Winner}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- League Standings -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Tabela ligowa" Style="{StaticResource SectionTitle}"/>
                                    <DataGrid ItemsSource="{Binding CurrentStandings}" AutoGenerateColumns="False"
                                              Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="None"
                                              RowBackground="Transparent" AlternatingRowBackground="#1C0E49"
                                              Foreground="#E0E1F1" FontSize="12">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#3A2878"/>
                                                <Setter Property="Foreground" Value="#FFC047"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Gracz" Binding="{Binding PlayerName}" Width="*"/>
                                            <DataGridTextColumn Header="M" Binding="{Binding Played}" Width="40"/>
                                            <DataGridTextColumn Header="W" Binding="{Binding Wins}" Width="40"/>
                                            <DataGridTextColumn Header="R" Binding="{Binding Draws}" Width="40"/>
                                            <DataGridTextColumn Header="P" Binding="{Binding Losses}" Width="40"/>
                                            <DataGridTextColumn Header="Pkt" Binding="{Binding Points}" Width="50"/>
                                            <DataGridTextColumn Header="+/-" Binding="{Binding GoalDifference}" Width="50"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding HasSelectedTournament, Converter={StaticResource InvBoolToVis}}">
                            <Border Style="{StaticResource CardBorder}" Padding="40">
                                <StackPanel HorizontalAlignment="Center">
                                    <fa:IconImage Icon="Trophy" Width="48" Height="48" Foreground="#3A2878"/>
                                    <TextBlock Text="Wybierz turniej z listy" Foreground="#7C80C2" FontSize="16" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                                    <TextBlock Text="lub utwórz nowy, aby zobaczyć szczegóły" Foreground="#9497CD" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
