<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Boardgame.ViewModel"
                    xmlns:view="clr-namespace:Boardgame.View">

    <DataTemplate DataType="{x:Type vm:MainWindowVM}">
        <view:MainWindow />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TableBoardGamesVM}">
        <view:TableBoardGames/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LoginVM}">
        <view:LoginView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StarPageVM}">
        <view:StartPage/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:AddBoardGameVM}">
        <view:AddBoardGame/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:EditBoardGameVM}">
        <view:EditBoardGame/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DrawingsVM}">
        <view:Drawing/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TournamentsVM}">
        <view:Tournaments/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EventsVM}">
        <view:Events/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CommunityVM}">
        <view:Community/>
    </DataTemplate>

</ResourceDictionary>